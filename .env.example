# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (Realtime broadcast 용) ──────────────────────────────────
# Project Settings > API Keys > publishable 키(sb_publishable_…)를 쓴다.
# legacy anon JWT(eyJ…)는 Supabase 가 폐기 예정이라 신규 설정에 쓰지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── DB (drizzle + postgres-js) ────────────────────────────────────────
# 전용 앱 롤(kkeutbal_app, bypassrls)로 pooler session mode(5432) 접속.
# 롤 생성은 supabase/migrations/0002 참조.
DATABASE_URL=postgresql://kkeutbal_app.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# ─── Auth.js v5 ────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# 첫 관리자 계정을 만들 때만 쓰는 비상 가입코드(혼동 문자 없는 영문 대문자·숫자 10자리).
# 이후 코드는 /admin에서 발급·회수
AUTH_REGISTRATION_CODE=

# 관리자 부트스트랩 — 쉼표로 구분한 내부 계정 아이디 목록.
# DB users.is_admin 과 OR 판정. 첫 관리자를 세울 때만 필요
AUTH_ADMIN_USERNAMES=

# Authentik OIDC — 3종 모두 설정해야 provider 활성. issuer 끝 슬래시 포함
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=
AUTH_AUTHENTIK_ISSUER=https://auth.example.com/application/o/kkeutbal/

# ─── 족보 Advisor (Claude vision, 선택) ────────────────────────────────
ANTHROPIC_API_KEY=
JOKBO_VISION_MODEL=claude-sonnet-5
# 수동 피커는 이 값과 무관하게 항상 동작
JOKBO_VISION_ENABLED=false
