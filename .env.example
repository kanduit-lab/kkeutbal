# Browser-exposed values
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=type-your-database-url-here
DATABASE_POOL_MODE=session
DATABASE_TLS_MODE=verify-ca
DATABASE_CA_CERT_BASE64=type-your-base64-encoded-postgres-ca-certificate-here

# Auth
AUTH_TRUST_HOST=type-your-auth-trust-host-value-here
AUTH_SECRET=type-your-auth-secret-value-here

# Realtime transport: self or supabase. REALTIME_<MODE>_* keys are read only in that mode.
REALTIME_MODE=self
# Required when DATABASE_POOL_MODE=transaction. Must be a session-capable endpoint.
REALTIME_SELF_LISTENER_URL=
REALTIME_SUPABASE_URL=
REALTIME_SUPABASE_PUBLISHABLE_KEY=

# Optional: photo-recognition API keys. /admin shows availability and selects the active provider/model.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
