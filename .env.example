# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (Realtime broadcast 용) ──────────────────────────────────
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── DB (drizzle + postgres-js) ────────────────────────────────────────
# 전용 앱 롤(kkeutbal_app, bypassrls)로 pooler session mode(5432) 접속.
# 롤 생성은 supabase/migrations/0002 참조.
DATABASE_URL=postgresql://kkeutbal_app.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# ─── Auth.js v5 ────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# 게스트 로그인(이름만 입력). 개발·MT 현장용 — 프로덕션에서는 반드시 false
AUTH_DEV_LOGIN=true

# Authentik OIDC — 3종 모두 설정해야 provider 활성. issuer 끝 슬래시 포함
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=
AUTH_AUTHENTIK_ISSUER=https://auth.example.com/application/o/kkeutbal/

# ─── 족보 Advisor (Claude vision, 선택) ────────────────────────────────
ANTHROPIC_API_KEY=
JOKBO_VISION_MODEL=claude-sonnet-5
# 수동 피커는 이 값과 무관하게 항상 동작
JOKBO_VISION_ENABLED=false
