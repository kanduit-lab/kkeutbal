# Browser-exposed values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only values
DATABASE_URL=postgresql://kkeutbal_app.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
# Base64-encoded Supabase CA certificate; required for TLS verification
DATABASE_CA_CERT_BASE64=
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Secret for GitHub Actions to call /api/keep-alive (32+ characters)
KEEP_ALIVE_SECRET=

# Optional: set both to enable card photo recognition
ANTHROPIC_API_KEY=
JOKBO_VISION_ENABLED=false
