# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (DB + Realtime) ──────────────────────────────────────────
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트로 노출 금지 (NEXT_PUBLIC_ 접두사 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle 직접 연결 (마이그레이션용). Supabase > Connect > Session pooler
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── Auth.js v5 + Authentik OIDC ───────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Authentik Provider > OAuth2/OpenID. issuer 끝 슬래시 포함
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=
AUTH_AUTHENTIK_ISSUER=https://auth.example.com/application/o/kkeutbal/

# Realtime 전용 Supabase JWT 서명 키 (Auth.js 세션 → Supabase RLS 브리지)
# Supabase > Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=

# ─── 족보 Advisor (Claude vision) ──────────────────────────────────────
ANTHROPIC_API_KEY=
# 카드 인식 기본 모델. 난해한 사진은 claude-opus-4-8로 승격
JOKBO_VISION_MODEL=claude-sonnet-5
# vision 인식 기능 토글 (수동 피커는 항상 동작)
JOKBO_VISION_ENABLED=true
