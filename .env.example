# Browser-exposed values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=type-your-supabase-url-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=type-your-supabase-publishable-key-here

# Server-only values
DATABASE_URL=type-your-database-url-here
# Base64-encoded Supabase CA certificate; required for TLS verification
DATABASE_CA_CERT_BASE64=type-your-base64-encoded-supabase-ca-certificate-here

AUTH_TRUST_HOST=type-your-auth-trust-host-value-here
AUTH_SECRET=type-your-auth-secret-value-here

# Optional: photo-recognition API keys. /admin shows availability and selects the active provider/model.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
