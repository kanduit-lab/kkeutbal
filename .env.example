# Browser-exposed values
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values
DATABASE_URL=type-your-database-url-here
DATABASE_TLS_MODE=verify-ca
DATABASE_CA_CERT_BASE64=type-your-base64-encoded-postgres-ca-certificate-here
DATABASE_POOL_MODE=session

AUTH_TRUST_HOST=type-your-auth-trust-host-value-here
AUTH_SECRET=type-your-auth-secret-value-here

# Realtime transport. Blank means self: same-origin SSE over PostgreSQL LISTEN/NOTIFY.
REALTIME_MODE=
# self only. Required when DATABASE_POOL_MODE=transaction; must be a session-capable endpoint.
DATABASE_LISTENER_URL=
# supabase only. Required when REALTIME_MODE=supabase and ignored otherwise.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: photo-recognition API keys. /admin shows availability and selects the active provider/model.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
